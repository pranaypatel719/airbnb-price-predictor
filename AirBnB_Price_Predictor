   "cell_type": "code",
   "execution_count": 10,
   "id": "0e97867e",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 2: Feature engineering\n",
    "df['multi_listings_host'] = df['calculated_host_listings_count'] > 1\n",
    "df['reviews_bin'] = pd.cut(df['number_of_reviews'], bins=[-1, 0, 5, 20, 100, 1000],\n",
    "                           labels=['0', '1-5', '6-20', '21-100', '100+'])\n",
    "df['min_nights_bin'] = pd.cut(df['minimum_nights'], bins=[-1, 1, 7, 30, 365],\n",
    "                               labels=['1', '2-7', '8-30', '31+'])\n",
    "df['region_room'] = df['neighbourhood_group'] + '_' + df['room_type']"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "29771496",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 3: Encode categorical features\n",
    "categorical = ['neighbourhood_group', 'neighbourhood', 'room_type', 'region_room', 'reviews_bin', 'min_nights_bin']\n",
    "df_encoded = pd.get_dummies(df, columns=categorical, drop_first=True)"
   ]
